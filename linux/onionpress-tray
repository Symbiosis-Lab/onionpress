    box.set_spacing(8)
    box.set_border_width(12)

    if not pw:
        lbl = Gtk.Label(label=(
            "No bootstrap admin password file found. If you can no longer "
            "log in, restore from a recent backup."))
        lbl.set_line_wrap(True)
        lbl.set_xalign(0)
        box.add(lbl)
    else:
        intro = Gtk.Label(label=(
            "Bootstrap admin account. Only needed if you lose access to "
            "the user you created in the setup wizard."))
