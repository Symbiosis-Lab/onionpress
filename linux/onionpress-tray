#!/usr/bin/env python3
"""OnionPress tray app for Ubuntu / Linux desktops.

A thin presentation layer around the bash launcher + shared Python ops
(src/onionpress/launcher_ops.py). Polls ~/.onionpress/status.json every
2 seconds and reflects state via the AppIndicator. State changes are
invoked through `/usr/local/bin/onionpress <subcommand>` so the
headless / SSH-only path remains the single source of truth.

The file deliberately stays one module — at ~700 lines it's easier to
audit and ship than a sprawling package. Split if it grows past 1000.
"""

import os
import sys

# ─── 0. Display gate (runs BEFORE gi imports) ───────────────────────────
# AppIndicator init touches D-Bus; on a tty-only system this would fail
# in confusing ways. Bail before we pull GTK in.
if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
    print("onionpress-tray: no display, exiting", file=sys.stderr)
    sys.exit(0)

import fcntl
import json
import logging
import logging.handlers
import signal
import subprocess
import threading
import time
from typing import Optional

# Ensure the shared `onionpress` package is importable. The .deb installs
# it at /opt/onionpress/lib/onionpress/; let callers override via PYTHONPATH.
INSTALL_DIR = os.environ.get("ONIONPRESS_INSTALL_DIR", "/opt/onionpress")
_LIB_DIR = os.path.join(INSTALL_DIR, "lib")
if _LIB_DIR not in sys.path:
    sys.path.insert(0, _LIB_DIR)

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
gi.require_version("Notify", "0.7")
from gi.repository import Gtk, GLib, AyatanaAppIndicator3 as AppIndicator, Notify, Gdk  # noqa: E402

try:
    from onionpress import launcher_ops  # type: ignore
except ImportError:
    launcher_ops = None  # tray still runs; some features degrade gracefully


# ─── Constants ──────────────────────────────────────────────────────────

DATA_DIR = os.path.expanduser("~/.onionpress")
STATUS_FILE = os.path.join(DATA_DIR, "status.json")
PIDFILE = os.path.join(DATA_DIR, "tray.pid")
TRAY_LOG = os.path.join(DATA_DIR, "tray.log")
ASSETS_DIR = os.path.join(INSTALL_DIR, "assets")
# Icons live under assets/hicolor/<size>x<size>/apps/<name>.png — the
# standard XDG icon-theme layout. AppIndicator's IconThemePath points
# at the hicolor parent and the icon engine resolves by name + size.
ICON_THEME_PATH = os.path.join(ASSETS_DIR, "hicolor")
LAUNCHER = "/usr/local/bin/onionpress"

# AyatanaAppIndicator's icon API takes icon NAMES (looked up via
# set_icon_theme_path), not paths. The StatusNotifier D-Bus protocol
# enforces this — passing a file path lands in IconName verbatim and
# fails to render on GNOME-Wayland (ubuntu-appindicators extension).
ICON_RUNNING = "tray-running"
ICON_STARTING = "tray-starting"
ICON_STOPPED = "tray-stopped"

POLL_INTERVAL_SEC = 2
NOTIFY_DEBOUNCE_SEC = 60


# ─── Logging ────────────────────────────────────────────────────────────

os.makedirs(DATA_DIR, exist_ok=True)
_log_handler = logging.handlers.RotatingFileHandler(
    TRAY_LOG, maxBytes=5 * 1024 * 1024, backupCount=3
)
_log_handler.setFormatter(logging.Formatter(
    "%(asctime)s %(levelname)s %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
))
logger = logging.getLogger("onionpress-tray")
logger.setLevel(logging.INFO)
logger.addHandler(_log_handler)
logger.addHandler(logging.StreamHandler())


def log(msg: str) -> None:
    logger.info(msg)


# ─── 1. Single-instance lock ────────────────────────────────────────────

def acquire_single_instance_lock() -> Optional[int]:
    """flock our PID file. Returns the fd on success, None if another
    tray instance already holds the lock (we then exit quietly).
    """
    fd = os.open(PIDFILE, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        return None
    os.ftruncate(fd, 0)
    os.write(fd, str(os.getpid()).encode())
    return fd


# ─── 2. Status reader (host-side status.json poller) ────────────────────

class Status:
    """Owns the latest status.json snapshot. Polls every POLL_INTERVAL_SEC
    seconds via GLib so callbacks fire on the GTK main thread.
    """

    def __init__(self, on_change):
        self.state = "unknown"
        self.onion_address = ""
        self.wp_installed = False
        self.onboarded = False
        self.mkp224o_available = False
        self.serving_from_wayback = False
        self.bootstrap_pct = 0
        self.uptime_seconds = 0
        self.containers = {}
        self.error_message = None
        self.raw = {}
        self._mtime = 0.0
        self._on_change = on_change
        GLib.timeout_add_seconds(POLL_INTERVAL_SEC, self._poll)

    def _poll(self) -> bool:
        try:
            mtime = os.path.getmtime(STATUS_FILE)
        except OSError:
            return True
        if mtime == self._mtime:
            return True
        self._mtime = mtime

        try:
            with open(STATUS_FILE) as f:
                data = json.load(f)
        except (OSError, json.JSONDecodeError) as e:
            log(f"status.json read failed: {e}")
            return True

        old = (self.state, self.wp_installed, self.onboarded,
               self.onion_address, self.serving_from_wayback)
        self.raw = data
        self.state = data.get("state", "unknown")
        self.onion_address = data.get("onion_address", "") or ""
        self.wp_installed = bool(data.get("wp_installed"))
        self.onboarded = bool(data.get("onboarded"))
        self.mkp224o_available = bool(data.get("mkp224o_available"))
        self.serving_from_wayback = bool(data.get("serving_from_wayback"))
        self.bootstrap_pct = int(data.get("bootstrap_pct", 0))
        self.uptime_seconds = int(data.get("uptime_seconds", 0))
        self.containers = dict(data.get("containers", {}))
        self.error_message = data.get("error_message")
        new = (self.state, self.wp_installed, self.onboarded,
               self.onion_address, self.serving_from_wayback)

        if old != new:
            try:
                self._on_change(old, new)
            except Exception as e:
                log(f"on_change handler raised: {e}")
        return True


# ─── 3. Launcher wrapper ────────────────────────────────────────────────

class Launcher:
    """Subprocess wrapper around `/usr/local/bin/onionpress`."""

    @staticmethod
    def run(*args, capture: bool = False, timeout: int = 60) -> subprocess.CompletedProcess:
        cmd = [LAUNCHER, *args]
        log(f"launcher: {' '.join(cmd)}")
        try:
            return subprocess.run(
                cmd, capture_output=capture, text=True, timeout=timeout,
            )
        except (subprocess.TimeoutExpired, FileNotFoundError) as e:
            log(f"launcher failed: {e}")
            raise

    @staticmethod
    def run_async(*args) -> None:
        """Fire and forget — used for actions where we don't wait."""
        cmd = [LAUNCHER, *args]
        log(f"launcher (async): {' '.join(cmd)}")
        try:
            subprocess.Popen(
                cmd, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                stdin=subprocess.DEVNULL,
                start_new_session=True,
            )
        except (OSError, FileNotFoundError) as e:
            log(f"launcher async failed: {e}")


# ─── 4. Notifier ────────────────────────────────────────────────────────

class Notifier:
    def __init__(self):
        Notify.init("OnionPress")
        self._last_fired: dict[str, float] = {}

    def notify(self, category: str, title: str, body: str = "",
               *, urgency: str = "normal",
               actions: Optional[list] = None) -> None:
        """Fire a notification, deduped by category for NOTIFY_DEBOUNCE_SEC.
        actions: list of (action_id, label, callback) tuples.
        """
        now = time.time()
        if now - self._last_fired.get(category, 0) < NOTIFY_DEBOUNCE_SEC:
            return
        self._last_fired[category] = now

        try:
            n = Notify.Notification.new(title, body, "onionpress")
            urgency_map = {
                "low": Notify.Urgency.LOW,
                "normal": Notify.Urgency.NORMAL,
                "critical": Notify.Urgency.CRITICAL,
            }
            n.set_urgency(urgency_map.get(urgency, Notify.Urgency.NORMAL))
            if actions:
                for aid, label, cb in actions:
                    n.add_action(aid, label, lambda _n, _a, _cb=cb: _cb())
            n.show()
        except Exception as e:
            log(f"notify failed: {e}")


# ─── 5. Pi detection ────────────────────────────────────────────────────

def is_raspberry_pi() -> bool:
    try:
        with open("/proc/cpuinfo") as f:
            blob = f.read()
        return "Raspberry Pi" in blob or "BCM2" in blob
    except OSError:
        return False


