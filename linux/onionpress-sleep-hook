#!/bin/bash
# OnionPress system-sleep hook.
#
# systemd-logind invokes scripts in /usr/lib/systemd/system-sleep/ around
# suspend/hibernate cycles, blocking the suspend until they return. We use
# that window to:
#   pre:  notify the OnionHeaven hub we're going offline + DEL_ONION our
#         descriptor so the hub can take over without a competing publish
#   post: ADD_ONION our descriptor back + send an immediate /online so the
#         hub stops fronting our site as soon as we're reachable again
#
# Arguments (per systemd's hook contract):
#   $1 = pre | post
#   $2 = suspend | hibernate | hybrid-sleep | suspend-then-hibernate
#
# Install path: /usr/lib/systemd/system-sleep/onionpress
#
# Runs as root. OnionPress on Linux is rootless-Docker / per-user, so we
# enumerate real users with an OnionPress data dir and run the launcher's
# `sleep-pre`/`sleep-post` subcommand as each, with a short timeout so a
# stuck Docker can't hold up the suspend.

set -e

ACTION="$1"
TYPE="$2"

# Only act on real sleep events; ignore other lifecycle hooks systemd
# may add in future versions.
case "$TYPE" in
    suspend|hibernate|hybrid-sleep|suspend-then-hibernate) ;;
    *) exit 0 ;;
esac

case "$ACTION" in
    pre|post) ;;
    *) exit 0 ;;
esac

LAUNCHER="/opt/onionpress/onionpress"
[ -x "$LAUNCHER" ] || exit 0

# Iterate every real (UID >= 1000, < 60000) user on the box and fire the
# launcher subcommand for any that have an OnionPress data dir. Single-
# user is the common case; multi-user just works.
while IFS=: read -r user _ uid _ _ home _; do
    [ "$uid" -ge 1000 ] || continue
    [ "$uid" -lt 60000 ] || continue
    [ -d "$home/.onionpress" ] || continue
    # 8-second per-user budget. The sleep-pre path now does a synchronous
    # /offline POST through Tor (~1-3s) before signaling tor-watchdog
    # containers (~1s), so 4s was too tight. systemd-logind allows hooks
    # ample time overall; this cap just prevents a wedged Docker from
    # stalling the suspend indefinitely.
    timeout 8 runuser -u "$user" -- env \
        XDG_RUNTIME_DIR="/run/user/$uid" \
        "$LAUNCHER" "sleep-$ACTION" >/dev/null 2>&1 || true
done < /etc/passwd

exit 0
