[Unit]
Description=OnionPress heartbeat client
After=onionpress.service
Wants=onionpress.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/onionpress/scripts/onionpress-heartbeat.py
Restart=always
RestartSec=30
TimeoutStopSec=30
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target
